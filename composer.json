{
  "name": "crasivo/bitrix-console",
  "description": "Symfony console adapter for 1C-Bitrix",
  "keywords": ["bitrix", "console", "adapter"],
  "version": "0.0.1",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Crasivo Dev",
      "email": "crasivo.dev@gmail.com",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/crasivo/bitrix-console/issues",
    "source": "https://github.com/crasivo/bitrix-console"
  },
  "bin": [
    "bin/console"
  ],
  "autoload": {
    "psr-4": {
      "Crasivo\\Bitrix\\Console\\": "src/"
    }
  },
  "require": {
    "php": "^7.2 || ^8.0",
    "symfony/console": "^5.0 || ^6.0"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
